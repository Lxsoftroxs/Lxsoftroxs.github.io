<body>
<h1>Heading‑Optimisation with Corner‑Cutting (v9.4)</h1>
<p>Client‑side port of the MATLAB prototype. Adjust parameters, hit <strong>Run Simulation</strong>, and explore:</p>
<ul>
 <li>Limited‑knowledge vs full‑knowledge best headings</li>
 <li>3‑D time‑terrain surfaces</li>
 <li>2‑D world map with corner‑cutting paths</li>
</ul>

<div id="ctrl">
  <label>Known POIs
    <input id="nk" type="number" min="1" max="20" value="10">
  </label>
  <label>Unknown POIs
    <input id="nu" type="number" min="0" max="30" value="10">
  </label>
  <label>v<sub>walk</sub> (m/s)
    <input id="vwalk" type="number" min="0.1" step="0.1" value="1">
  </label>
  <label>v<sub>road</sub> (m/s)
    <input id="vroad" type="number" min="0.5" step="0.5" value="4">
  </label>
  <label>Grid N
    <input id="gridN" type="number" min="60" max="300" value="120">
  </label>
  <button id="runBtn">Run Simulation</button>
</div>

<div id="plots">
  <div id="terrainLim" class="plot"></div>
  <div id="terrainFull" class="plot"></div>
  <div id="world" class="plot"></div>
</div>

<script>
/******************** Utility helpers *************************/
const rand=(a,b)=>Math.random()*(b-a)+a;
const randPt=box=>[rand(0,box),rand(0,box)];
function hypot2(x,y){return Math.hypot(x,y);} // alias
/******************** Build road network **********************/
function buildNetwork(mask, pois, vR){
  const n=mask.length;
  const roads=[];
  const W=Array.from({length:pois.length},(_,i)=>Array(pois.length).fill(Infinity));
  for(let i=0;i<pois.length;i++)W[i][i]=0;
  for(let a=0;a<n;a++){
    const i=mask[a];
    for(let b=0;b<a;b++){
      const j=mask[b];
      const p1=pois[i], p2=pois[j];
      const d=hypot2(p1[0]-p2[0], p1[1]-p2[1]);
      W[i][j]=W[j][i]=d/vR;
      roads.push({p1, p2, i, j, len:d});
    }
  }
  return {roads, W};
}
/******************** Floyd‑Warshall **************************/
function floydWarshall(W){
  const D=W.map(r=>r.slice());
  const n=D.length;
  for(let k=0;k<n;k++)
    for(let i=0;i<n;i++)
      for(let j=0;j<n;j++){
        const alt=D[i][k]+D[k][j];
        if(alt<D[i][j])D[i][j]=alt;
      }
  return D;
}
/******************** Geometric helpers ***********************/
function rayHit(S,dir,roads){
  let hit=null,r=Infinity;
  for(const rd of roads){
    const P=rd.p1, Q=rd.p2, w=[Q[0]-P[0],Q[1]-P[1]];
    const A=[[dir[0],-w[0]],[dir[1],-w[1]]];
    const b=[P[0]-S[0],P[1]-S[1]];
    const det=A[0][0]*A[1][1]-A[0][1]*A[1][0];
    if(Math.abs(det)<1e-12)continue;
    const t=(b[0]*A[1][1]-b[1]*A[0][1])/det;
    const u=(A[0][0]*b[1]-A[1][0]*b[0])/det;
    if(t<0||u<0||u>1)continue;
    if(t<r){r=t;hit=[S[0]+t*dir[0],S[1]+t*dir[1]];}
  }
  return {hit,r};
}
function hybridTime(r,hit,roads,vW,vR,tDest){
  const t0=r/vW; let best=Infinity;
  for(const rd of roads){
    const d1=hypot2(hit[0]-rd.p1[0],hit[1]-rd.p1[1]);
    const d2=hypot2(hit[0]-rd.p2[0],hit[1]-rd.p2[1]);
    best=Math.min(best, d1/vR+tDest[rd.i], d2/vR+tDest[rd.j]);
  }
  return t0+best;
}
function bestHeading(S,roads,pois,vW,vR,idxDest,res,tDest){
  let bestT=Infinity,bestTh=0; const twoPi=2*Math.PI;
  for(let k=0;k<res;k++){
    const th=k*twoPi/res; const dir=[Math.cos(th),Math.sin(th)];
    const {hit,r}=rayHit(S,dir,roads);
    let T;
    if(!hit){T=hypot2(pois[idxDest][0]-S[0],pois[idxDest][1]-S[1])/vW;}
    else{T=hybridTime(r,hit,roads,vW,vR,tDest);}    
    if(T<bestT){bestT=T;bestTh=th;}
  }
  return {theta:bestTh,time:bestT};
}
/******************** Time‑terrain grid ***********************/
function computeTerrain(pois,tDest,vW,vR,roads,N,box){
  const axis=[...Array(N).keys()].map(i=>i*box/(N-1));
  const Z=Array.from({length:N},()=>Array(N).fill(0));
  for(let ix=0;ix<N;ix++){
    for(let iy=0;iy<N;iy++){
      let zx=axis[ix], zy=axis[iy];
      let minT=hypot2(zx-pois[0][0],zy-pois[0][1])/vW; // direct walk
      for(let i=0;i<pois.length;i++){
        if(!isFinite(tDest[i]))continue;
        const cand=hypot2(zx-pois[i][0],zy-pois[i][1])/vW+tDest[i];
        if(cand<minT)minT=cand;
      }
      // project onto every road
      for(const rd of roads){
        const P=rd.p1,Q=rd.p2,v=[Q[0]-P[0],Q[1]-P[1]];
        const len2=v[0]*v[0]+v[1]*v[1]; if(len2===0)continue;
        let w=((zx-P[0])*v[0]+(zy-P[1])*v[1])/len2; w=Math.max(0,Math.min(1,w));
        const xp=P[0]+w*v[0], yp=P[1]+w*v[1];
        const walkT=hypot2(zx-xp,zy-yp)/vW;
        const dProj=w*Math.sqrt(len2); const dRem=Math.sqrt(len2)-dProj;
        const viaP=dProj/vR+tDest[rd.i];
        const viaQ=dRem/vR+tDest[rd.j];
        const cand=walkT+Math.min(viaP,viaQ);
        if(cand<minT)minT=cand;
      }
      Z[iy][ix]=minT;
    }
  }
  return {axis,Z};
}
/******************** Plot helpers ****************************/
function toMeshgridAxis(axis){return axis;}
function plotTerrain(divId,terrain,title){
  const {axis,Z}=terrain;
  Plotly.newPlot(divId,[{z:Z,x:axis,y:axis,type:"surface",colorscale:"Turbo"}],
    {title,font:{color:"#eee"},scene:{xaxis:{title:"x"},yaxis:{title:"y"},zaxis:{title:"t (s)"}}});
}
function plotWorld(divId,S,pois,roads,pathLim,pathFul,box){
  const traces=[];
  // Roads
  roads.forEach(r=>{traces.push({x:[r.p1[0],r.p2[0]],y:[r.p1[1],r.p2[1]],mode:"lines",line:{color:"#aaa"},hoverinfo:"skip",showlegend:false});});
  // Unknown, known, dest, start
  const unknownIdx=[...Array(pois.length).keys()].slice(pathLim.numKnown);
  traces.push({x:unknownIdx.map(i=>pois[i][0]),y:unknownIdx.map(i=>pois[i][1]),mode:"markers",marker:{symbol:"circle-open",size:10,color:"#2ecc71"},name:"Unknown"});
  traces.push({x:[pois[0][0]],y:[pois[0][1]],mode:"markers",marker:{symbol:"diamond",size:14,color:"#3498db"},name:"Destination"});
  traces.push({x:[S[0]],y:[S[1]],mode:"markers",marker:{symbol:"square",size:14,color:"#e74c3c"},name:"Start"});
  // Paths
  traces.push({x:pathLim.coords.map(p=>p[0]),y:pathLim.coords.map(p=>p[1]),mode:"lines",line:{width:3,color:"#e91e63"},name:"Limited"});
  traces.push({x:pathFul.coords.map(p=>p[0]),y:pathFul.coords.map(p=>p[1]),mode:"lines",line:{width:3,color:"#00e0ff"},name:"Full"});
  Plotly.newPlot(divId,traces,{title:"World map",xaxis:{range:[0,box]},yaxis:{range:[0,box],scaleanchor:"x"},height:450});
}
/******************** Main driver ****************************/
async function run(){
  const nk=+nkElem.value, nu=+nuElem.value; const vW=+vwalkElem.value, vR=+vroadElem.value, N=+gridNElem.value; const box=1000, res=720;
  const S=randPt(box);
  const pois=Array.from({length:nk+nu},()=>randPt(box));
  const idxDest=0;
  const {roads:roadsFull, W:WFull}=buildNetwork([...Array(pois.length).keys()],pois,vR);
  const {roads:roadsLtd , W:WLtd }=buildNetwork([...Array(nk).keys()],pois,vR);
  // add Inf rows for unknown in ltd
  const Dfull=floydWarshall(WFull);
  const Dltd =floydWarshall(WLtd);
  const tDestFul=Dfull.map(r=>r[idxDest]);
  let tDestLtd=[...Dltd.map(r=>r[idxDest]), ...Array(nu).fill(Infinity)];
  const bestLim=bestHeading(S,roadsLtd,pois,vW,vR,idxDest,res,tDestLtd);
  const bestFul=bestHeading(S,roadsFull,pois,vW,vR,idxDest,res,tDestFul);
  bestLim.coords=[S, [S[0]+Math.cos(bestLim.theta)*box*0.05, S[1]+Math.sin(bestLim.theta)*box*0.05]];
  bestFul.coords=[S, [S[0]+Math.cos(bestFul.theta)*box*0.05, S[1]+Math.sin(bestFul.theta)*box*0.05]];
  bestLim.numKnown=nk;

  // terrains (may be heavy)
  const terrainLim=computeTerrain(pois,tDestLtd,vW,vR,roadsLtd,N,box);
  const terrainFul=computeTerrain(pois,tDestFul,vW,vR,roadsFull,N,box);

  plotTerrain("terrainLim",terrainLim,"Limited knowledge – time terrain");
  plotTerrain("terrainFull",terrainFul,"Full knowledge – time terrain");
  plotWorld("world",S,pois,roadsFull,bestLim,bestFul,box);
}
const nkElem=document.getElementById("nk");
const nuElem=document.getElementById("nu");
const vwalkElem=document.getElementById("vwalk");
const vroadElem=document.getElementById("vroad");
const gridNElem=document.getElementById("gridN");
document.getElementById("runBtn").addEventListener("click",()=>{document.getElementById("runBtn").disabled=true;run().then(()=>document.getElementById("runBtn").disabled=false);});
</script>
</body>
</html>
