  <style>
    body{font-family:system-ui,Roboto,Arial,sans-serif;background:#111;color:#eee;margin:0;padding:1rem}
    h1{margin-top:0}
    #ctrl{display:flex;flex-wrap:wrap;gap:1rem;margin-bottom:1rem;background:#222;padding:1rem;border-radius:0.75rem}
    #ctrl label{display:flex;flex-direction:column;font-size:0.9rem}
    input[type=number]{width:6rem;padding:0.3rem;border-radius:0.25rem;border:1px solid #555;background:#333;color:#eee}
